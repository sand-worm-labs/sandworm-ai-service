AI_HANDSHAKE_TOKEN=secret_for_ai_service
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEST_BASE_URL=http://localhost:8003/api/
REDIS_URL=redis://sandworm-redis:6379/0
QDRANT_URL=http://sandworm-qdrant:6333
QDRANT_API_KEY=
OPENROUTER_EMBEDDING_KEY=your_openrouter_embedding_key
# Chat is a tool-calling loop over the MCP server; every notebook read and write goes through it.
MCP_URL=http://host.docker.internal:6789/mcp
# Optional: limit which MCP tools the agent offers (comma-separated names).
# AGENT_INCLUDE_TOOLS=
# AGENT_EXCLUDE_TOOLS=
# AGENT_MAX_STEPS=15
# Per-run limits for the chat agent (steps above; seconds and total model tokens here).
# AGENT_MAX_SECONDS=600
# AGENT_MAX_TOKENS=300000
# Notebook memory embeds locally with fastembed (BAAI/bge-small-en-v1.5): free, no key.
# The ~70MB model downloads on first use; mount a volume on the cache folder to keep it between deploys.
